{
    "name": "Android-Game-Template Dev Environment",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "fwcd.kotlin",
                "vscjava.vscode-gradle",
                "adelphes.android-dev-ext",
                "mathiasfrohlich.kotlin",
                "ms-azuretools.vscode-docker",
                "editorconfig.editorconfig"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "[kotlin]": {
                    "editor.tabSize": 4
                }
            }
        }
    },
    "containerEnv": {
        "ANDROID_SDK_ROOT": "/opt/android-sdk",
        "ANDROID_HOME": "/opt/android-sdk"
    },
    "postCreateCommand": "yes | sdkmanager --licenses > /dev/null && ./gradlew --version && pre-commit install",
    "remoteUser": "vscode"
}
